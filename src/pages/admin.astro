---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="写作后台" description="博客写作与站点管理">
  <main class="admin-shell">
    <header class="admin-topbar">
      <div>
        <h1>写作后台</h1>
      </div>
      <div class="topbar-actions">
        <button id="posts-mode-button" type="button">博客文章</button>
        <button id="pages-mode-button" class="ghost-button" type="button"
          >个人简介</button
        >
        <button id="settings-mode-button" class="ghost-button" type="button">
          站点设置
        </button>
        <a class="ghost-link" href="/" target="_blank" rel="noreferrer"
          >查看博客</a
        >
      </div>
    </header>

    <section class="admin-grid">
      <aside class="post-browser" aria-label="博客文章列表">
        <div class="browser-heading">
          <h2>文章</h2><button id="new-post-button" type="button"
            >新建文章</button>
        </div>
        <div class="browser-tools">
          <label>
            搜索
            <input
              id="search-input"
              type="search"
              placeholder="搜索标题、标签或路径"
            />
          </label>
          <label>
            发表状态
            <select id="status-filter">
              <option value="all">全部文章</option>
              <option value="draft">草稿</option>
              <option value="published">已发表</option>
            </select>
          </label>
        </div>
        <div class="browser-meta">
          <span id="post-count">0 篇文章</span>
          <span id="api-state">连接中</span>
        </div>
        <div id="post-list" class="post-list" role="list"></div>
      </aside>

      <section class="editor-panel" aria-label="文章编辑">
        <form id="editor-form" class="editor-form admin-view" data-view="posts">
          <div class="form-row title-row">
            <label>
              标题
              <input id="title-input" name="title" required />
            </label>
            <label class="draft-toggle">
              <input id="draft-input" name="draft" type="checkbox" />
              草稿
            </label>
          </div>

          <details class="post-options">
            <summary>发布信息</summary>
            <div class="form-row">
              <label>
                摘要
                <textarea id="description-input" name="description" rows="2"
                ></textarea>
              </label>
            </div>

            <div class="form-row split-row">
              <label>
                发表时间
                <input id="date-input" name="pubDatetime" type="text" />
              </label>
              <label>
                标签
                <input
                  id="tags-input"
                  name="tags"
                  placeholder="产品, 社区, 随想"
                />
              </label>
            </div>

            <div class="file-line">
              <span id="file-path">尚未选择文章</span>
              <a
                id="preview-link"
                href="/posts/"
                target="_blank"
                rel="noreferrer"
              >
                查看已保存文章
              </a>
            </div>
          </details>
          <div class="workspace-tabs" role="group" aria-label="文章编辑模式">
            <button type="button" class="active" data-mode="edit">写作</button>
            <button type="button" data-mode="preview">预览</button>
          </div>

          <div class="writing-surface" data-mode="edit">
            <textarea
              id="body-input"
              name="body"
              spellcheck="false"
              placeholder="开始撰写正文…"></textarea>
            <article id="markdown-preview" class="markdown-preview app-prose">
            </article>
          </div>

          <footer class="editor-actions">
            <p id="save-state" aria-live="polite">就绪</p>
            <div class="editor-command-group">
              <button
                id="delete-post-button"
                class="danger-button"
                type="button"
                disabled
              >
                删除文章
              </button>
              <button id="save-button" type="submit">保存文章</button>
            </div>
          </footer>
        </form>

        <form
          id="settings-form"
          class="settings-form admin-view"
          data-view="settings"
          hidden
        >
          <div class="settings-heading">
            <div>
              <p class="eyebrow">站点设置</p>
              <h2>首页与社交信息</h2>
            </div>
            <button id="save-settings-button" type="submit">保存设置</button>
          </div>

          <div class="settings-grid">
            <label>
              博客名称
              <input id="setting-title" name="title" />
            </label>
            <label>
              作者
              <input id="setting-author" name="author" />
            </label>
            <label>
              博客网址
              <input id="setting-website" name="website" />
            </label>
            <label>
              个人主页链接
              <input id="setting-profile" name="profile" />
            </label>
          </div>

          <label>
            博客简介
            <textarea id="setting-desc" rows="2"></textarea>
          </label>

          <label>
            首页标题
            <input id="setting-home-heading" />
          </label>
          <label>
            首页介绍
            <textarea id="setting-home-intro" rows="4"></textarea>
          </label>
          <label>
            首页补充介绍
            <textarea id="setting-home-secondary" rows="3"></textarea>
          </label>
          <label>
            社交链接标题
            <input id="setting-social-label" />
          </label>

          <label>
            社交链接（JSON）
            <textarea id="setting-socials" rows="8" spellcheck="false"
            ></textarea>
          </label>

          <p id="settings-state" aria-live="polite">设置已加载</p>
        </form>

        <form
          id="pages-form"
          class="settings-form page-form admin-view"
          data-view="pages"
          hidden
        >
          <div class="settings-heading">
            <div>
              <h2>个人简介</h2>
            </div>
            <div class="page-actions">
              <a
                class="ghost-link"
                href="/about/"
                target="_blank"
                rel="noreferrer">查看个人简介</a
              >
              <button id="save-page-button" type="submit">保存简介</button>
            </div>
          </div>

          <label>
            简介标题
            <input id="page-title" />
          </label>

          <div
            class="workspace-tabs"
            role="group"
            aria-label="个人简介编辑模式"
          >
            <button type="button" class="active" data-page-mode="edit"
              >写作</button
            >
            <button type="button" data-page-mode="preview">预览</button>
          </div>

          <div class="writing-surface page-writing-surface" data-mode="edit">
            <textarea
              id="page-body-input"
              spellcheck="false"
              placeholder="撰写个人简介…"></textarea>
            <article
              id="page-markdown-preview"
              class="markdown-preview app-prose"
            >
            </article>
          </div>

          <p id="pages-state" aria-live="polite">简介已就绪</p>
        </form>
      </section>
    </section>
  </main>
</Layout>

<style>
  .admin-shell [hidden] {
    display: none !important;
  }
  .admin-grid.single-view {
    grid-template-columns: minmax(0, 1fr);
  }
  .browser-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    gap: 12px;
    border-bottom: 1px solid #ddd;
  }
  .browser-heading h2 {
    font-size: 16px;
    font-weight: 700;
  }
  .post-options {
    border-bottom: 1px solid #ddd;
    padding-bottom: 12px;
  }
  .post-options summary {
    cursor: pointer;
    font-size: 14px;
    color: #555;
  }
  .post-options[open] > .form-row {
    margin-top: 14px;
  }
  .markdown-preview {
    max-width: none;
    --foreground: #242424;
    --background: #fff;
    --muted: #eee;
    --border: #ddd;
    --accent: #006cac;
  }
  :global(body) {
    min-width: 320px;
  }

  .admin-shell {
    min-height: 100vh;
    background: #f5f6f7;
    color: #242424;
    padding: 24px;
  }

  .admin-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1440px;
    margin: 0 auto 20px;
  }

  .eyebrow {
    margin: 0 0 4px;
    color: #68645d;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 22px;
    line-height: 1.1;
  }

  .topbar-actions,
  .editor-actions,
  .editor-command-group,
  .file-line,
  .browser-meta,
  .workspace-tabs,
  .page-actions {
    display: flex;
    align-items: center;
  }

  .topbar-actions,
  .page-actions {
    gap: 10px;
    flex-wrap: wrap;
  }

  button,
  .ghost-link,
  .ghost-button {
    min-height: 40px;
    border: 1px solid #242424;
    border-radius: 6px;
    background: #242424;
    color: #fff;
    padding: 0 14px;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ghost-link,
  .ghost-button,
  .workspace-tabs button {
    background: transparent;
    color: #242424;
  }

  .topbar-actions button.active {
    background: #242424;
    color: #fff;
  }

  .admin-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .post-browser,
  .editor-panel {
    border: 1px solid #d8d2c7;
    border-radius: 8px;
    background: #fff;
    min-height: calc(100vh - 128px);
  }

  .post-browser {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .browser-tools {
    display: grid;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid #e5ded2;
  }

  label {
    display: grid;
    gap: 6px;
    color: #5f5a52;
    font-size: 0.82rem;
    font-weight: 700;
  }

  input,
  textarea,
  select {
    width: 100%;
    border: 1px solid #d8d2c7;
    border-radius: 6px;
    background: #fff;
    color: #242424;
    font: inherit;
    padding: 10px 11px;
  }

  textarea {
    resize: vertical;
  }

  .browser-meta {
    justify-content: space-between;
    gap: 10px;
    padding: 10px 16px;
    color: #68645d;
    border-bottom: 1px solid #e5ded2;
    font-size: 0.78rem;
  }

  .post-list {
    overflow: auto;
    display: grid;
    gap: 6px;
    padding: 8px;
  }

  :global(.post-item) {
    width: 100%;
    min-height: 72px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 5px;
    align-content: center;
    justify-content: stretch;
    justify-items: stretch;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #242424;
    padding: 10px 12px;
    text-align: left;
    font: inherit;
  }

  :global(.post-item:hover),
  :global(.post-item.active) {
    border-color: #c8bba9;
    background: #f7efe3;
  }

  :global(.post-title),
  :global(.post-meta) {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: left;
  }

  :global(.post-title) {
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.35;
  }

  :global(.post-meta) {
    color: #746e64;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .editor-panel {
    min-height: 0;
    padding: 16px;
    overflow: hidden;
  }

  .editor-form {
    min-height: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .settings-form {
    min-height: 100%;
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .settings-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid #e5ded2;
    padding-bottom: 14px;
  }

  .settings-heading h2 {
    margin: 0;
    color: #242424;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  #setting-socials,
  #page-body-input {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    line-height: 1.55;
  }

  .form-row {
    display: grid;
    gap: 12px;
  }

  .title-row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .split-row {
    grid-template-columns: minmax(180px, 0.8fr) minmax(220px, 1.2fr);
  }

  .draft-toggle {
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #d8d2c7;
    border-radius: 6px;
    padding: 0 12px;
    color: #242424;
  }

  .draft-toggle input {
    width: auto;
  }

  .file-line {
    justify-content: space-between;
    gap: 12px;
    color: #68645d;
    font-size: 0.82rem;
  }

  #file-path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #preview-link {
    color: #005f8f;
    font-weight: 700;
    text-decoration: none;
  }

  .workspace-tabs {
    gap: 8px;
  }

  .workspace-tabs button {
    min-height: 34px;
    border-color: #d8d2c7;
    padding: 0 12px;
  }

  .workspace-tabs button.active {
    border-color: #242424;
    background: #242424;
    color: #fff;
  }

  .writing-surface {
    min-height: 0;
    height: clamp(420px, calc(100vh - 360px), 760px);
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-auto-rows: minmax(0, 1fr);
    gap: 12px;
  }

  .writing-surface[data-mode="edit"] {
    grid-template-columns: 1fr;
  }

  .writing-surface[data-mode="preview"] {
    grid-template-columns: 1fr;
  }

  .writing-surface[data-mode="edit"] .markdown-preview,
  .writing-surface[data-mode="preview"] textarea {
    display: none;
  }

  #body-input,
  #page-body-input,
  .markdown-preview {
    min-width: 0;
    min-height: 0;
    height: 100%;
    border: 1px solid #d8d2c7;
    border-radius: 8px;
    background: #fff;
    box-sizing: border-box;
  }

  #body-input,
  #page-body-input {
    resize: none;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    line-height: 1.65;
  }

  .markdown-preview {
    overflow: auto;
    padding: 18px;
    line-height: 1.75;
  }

  .markdown-preview :global(.preview-error) {
    color: #9f1239;
    font-weight: 600;
  }

  .editor-actions {
    justify-content: space-between;
    gap: 12px;
  }

  .editor-command-group {
    gap: 10px;
  }

  .danger-button {
    border-color: #9f1239;
    background: transparent;
    color: #9f1239;
  }

  .danger-button:hover:not(:disabled),
  .danger-button:focus-visible:not(:disabled) {
    background: #9f1239;
    color: #fff;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  #save-state,
  #settings-state {
    margin: 0;
    color: #68645d;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .admin-shell {
      padding: 16px;
    }

    .admin-topbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .admin-grid,
    .settings-grid,
    .split-row,
    .title-row {
      grid-template-columns: 1fr;
    }

    .settings-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .post-browser,
    .editor-panel {
      min-height: auto;
    }

    .post-list {
      max-height: 320px;
    }

    .writing-surface,
    .writing-surface[data-mode="split"] {
      grid-template-columns: 1fr;
    }

    .writing-surface[data-mode="split"] #body-input,
    .writing-surface[data-mode="split"] .markdown-preview {
      min-height: 320px;
    }
  }
</style>

<script>
  // @ts-nocheck
  import { marked } from "marked";
  import DOMPurify from "dompurify";
  const state = {
    posts: [],
    selectedId: null,
    selectedPost: null,
    settings: null,
    page: null,
    mode: "edit",
    pageMode: "edit",
    view: "posts",
  };

  const elements = {
    apiState: document.querySelector("#api-state"),
    body: document.querySelector("#body-input"),
    date: document.querySelector("#date-input"),
    deletePost: document.querySelector("#delete-post-button"),
    description: document.querySelector("#description-input"),
    draft: document.querySelector("#draft-input"),
    filePath: document.querySelector("#file-path"),
    form: document.querySelector("#editor-form"),
    list: document.querySelector("#post-list"),
    newPost: document.querySelector("#new-post-button"),
    pageBody: document.querySelector("#page-body-input"),
    pageForm: document.querySelector("#pages-form"),
    pagePreview: document.querySelector("#page-markdown-preview"),
    pageState: document.querySelector("#pages-state"),
    pageSurface: document.querySelector(".page-writing-surface"),
    pageTabs: document.querySelectorAll("[data-page-mode]"),
    pageTitle: document.querySelector("#page-title"),
    pagesMode: document.querySelector("#pages-mode-button"),
    postsMode: document.querySelector("#posts-mode-button"),
    postCount: document.querySelector("#post-count"),
    preview: document.querySelector("#markdown-preview"),
    previewLink: document.querySelector("#preview-link"),
    saveState: document.querySelector("#save-state"),
    search: document.querySelector("#search-input"),
    settingsForm: document.querySelector("#settings-form"),
    settingsMode: document.querySelector("#settings-mode-button"),
    settingsState: document.querySelector("#settings-state"),
    settingAuthor: document.querySelector("#setting-author"),
    settingDesc: document.querySelector("#setting-desc"),
    settingHomeHeading: document.querySelector("#setting-home-heading"),
    settingHomeIntro: document.querySelector("#setting-home-intro"),
    settingHomeSecondary: document.querySelector("#setting-home-secondary"),
    settingProfile: document.querySelector("#setting-profile"),
    settingSocialLabel: document.querySelector("#setting-social-label"),
    settingSocials: document.querySelector("#setting-socials"),
    settingTitle: document.querySelector("#setting-title"),
    settingWebsite: document.querySelector("#setting-website"),
    status: document.querySelector("#status-filter"),
    surface: document.querySelector(".writing-surface"),
    tags: document.querySelector("#tags-input"),
    title: document.querySelector("#title-input"),
    tabs: document.querySelectorAll("button[data-mode]"),
  };

  const request = async (url, options = {}) => {
    const response = await fetch(url, {
      headers: { "Content-Type": "application/json" },
      ...options,
    });

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(data.error || "请求失败");
    }

    return data;
  };

  const escapeHtml = value =>
    value.replace(
      /[&<>"']/g,
      char =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[char]
    );

  marked.use({
    async: false,
    breaks: true,
    gfm: true,
  });

  const markdownToHtml = async markdown => {
    const rawHtml = await marked.parse(markdown || "");
    return DOMPurify.sanitize(rawHtml, {
      USE_PROFILES: { html: true },
    });
  };

  const previewRenderIds = new WeakMap();

  const postUrl = post => `/posts/${post.slug}/`;

  const setStatus = message => {
    elements.saveState.textContent = message;
  };

  const setSettingsStatus = message => {
    elements.settingsState.textContent = message;
  };

  const setPagesStatus = message => {
    elements.pageState.textContent = message;
  };

  const setAdminView = view => {
    state.view = view;
    document.querySelector(".post-browser").hidden = view !== "posts";
    document
      .querySelector(".admin-grid")
      .classList.toggle("single-view", view !== "posts");
    elements.form.hidden = view !== "posts";
    elements.pageForm.hidden = view !== "pages";
    elements.settingsForm.hidden = view !== "settings";
    elements.postsMode.classList.toggle("active", view === "posts");
    elements.pagesMode.classList.toggle("active", view === "pages");
    elements.settingsMode.classList.toggle("active", view === "settings");
    elements.newPost.hidden = view !== "posts";

    if (view === "pages" && !state.page) {
      loadPage().catch(error => setPagesStatus(error.message));
    }

    if (view === "settings" && !state.settings) {
      loadSettings().catch(error => setSettingsStatus(error.message));
    }
  };

  const renderMarkdownPreview = async (source, target) => {
    const renderId = (previewRenderIds.get(target) || 0) + 1;
    previewRenderIds.set(target, renderId);

    try {
      const html = await markdownToHtml(source.value || "");
      if (renderId === previewRenderIds.get(target)) target.innerHTML = html;
    } catch (error) {
      if (renderId === previewRenderIds.get(target)) {
        target.innerHTML = `<p class="preview-error">Markdown 预览失败： ${escapeHtml(error.message || "未知错误")}</p>`;
      }
    }
  };

  const renderPreview = () =>
    renderMarkdownPreview(elements.body, elements.preview);

  const renderPagePreview = () =>
    renderMarkdownPreview(elements.pageBody, elements.pagePreview);

  const filteredPosts = () => {
    const query = elements.search.value.trim().toLowerCase();
    const status = elements.status.value;

    return state.posts.filter(post => {
      const matchesStatus =
        status === "all" ||
        (status === "draft" && post.draft) ||
        (status === "published" && !post.draft);
      const haystack =
        `${post.title} ${post.tags.join(" ")} ${post.filePath}`.toLowerCase();

      return matchesStatus && (!query || haystack.includes(query));
    });
  };

  const renderList = () => {
    const posts = filteredPosts();
    elements.postCount.textContent = `${posts.length} 篇文章`;
    elements.list.innerHTML = posts
      .map(
        post => `
        <button class="post-item ${post.id === state.selectedId ? "active" : ""}" data-id="${post.id}" type="button">
          <strong class="post-title">${escapeHtml(post.title)}</strong>
          <span class="post-meta">${escapeHtml(post.pubDatetime.slice(0, 10))} · ${post.draft ? "草稿" : "已发表"}</span>
        </button>
      `
      )
      .join("");
  };

  const clearEditor = () => {
    state.selectedId = null;
    state.selectedPost = null;
    elements.title.value = "";
    elements.description.value = "";
    elements.date.value = new Date().toISOString();
    elements.tags.value = "";
    elements.draft.checked = true;
    elements.body.value = "";
    elements.filePath.textContent = "尚未选择文章";
    elements.previewLink.href = "/posts/";
    elements.deletePost.disabled = true;
    void renderPreview();
    renderList();
  };

  const populateEditor = post => {
    state.selectedId = post.id;
    state.selectedPost = post;
    elements.title.value = post.title || "";
    elements.description.value = post.description || "";
    elements.date.value = post.pubDatetime || new Date().toISOString();
    elements.tags.value = (post.tags || []).join(", ");
    elements.draft.checked = Boolean(post.draft);
    elements.body.value = post.body || "";
    elements.deletePost.disabled = false;
    elements.filePath.textContent = post.filePath || "新建文章";
    elements.previewLink.href = post.slug ? postUrl(post) : "/posts/";
    void renderPreview();
    renderList();
    setStatus("就绪");
  };

  const loadPost = async id => {
    setStatus("正在加载文章");
    const data = await request(`/api/admin/posts/${id}`);
    populateEditor(data.post);
  };

  const loadPosts = async () => {
    try {
      elements.apiState.textContent = "连接中";
      const data = await request("/api/admin/posts");
      state.posts = data.posts;
      elements.apiState.textContent = "已连接";
      renderList();

      if (state.posts[0]) await loadPost(state.posts[0].id);
      else clearEditor();
    } catch (error) {
      elements.apiState.textContent = "连接失败";
      elements.list.innerHTML = `
        <p class="post-item">
          本地写作服务未连接，请启动服务：
          <code>corepack pnpm run dev --host 127.0.0.1</code>.
        </p>
      `;
      setStatus(error.message);
    }
  };

  const populateSettings = settings => {
    state.settings = settings;
    elements.settingTitle.value = settings.site?.title || "";
    elements.settingAuthor.value = settings.site?.author || "";
    elements.settingWebsite.value = settings.site?.website || "";
    elements.settingProfile.value = settings.site?.profile || "";
    elements.settingDesc.value = settings.site?.desc || "";
    elements.settingHomeHeading.value = settings.home?.heading || "";
    elements.settingHomeIntro.value = settings.home?.intro || "";
    elements.settingHomeSecondary.value = settings.home?.secondary || "";
    elements.settingSocialLabel.value = settings.home?.socialLabel || "";
    elements.settingSocials.value = JSON.stringify(
      settings.socials || [],
      null,
      2
    );
    setSettingsStatus("设置已加载");
  };

  const loadSettings = async () => {
    setSettingsStatus("正在加载设置");
    const data = await request("/api/admin/settings");
    populateSettings(data.settings);
  };

  const saveSettings = async () => {
    setSettingsStatus("正在保存设置");

    let socials = [];
    try {
      socials = JSON.parse(elements.settingSocials.value || "[]");
      if (!Array.isArray(socials)) throw new Error("社交链接必须是数组");
    } catch (error) {
      throw new Error(`社交链接 JSON 格式错误： ${error.message}`);
    }

    const data = await request("/api/admin/settings", {
      method: "PUT",
      body: JSON.stringify({
        site: {
          title: elements.settingTitle.value.trim(),
          author: elements.settingAuthor.value.trim(),
          website: elements.settingWebsite.value.trim(),
          profile: elements.settingProfile.value.trim(),
          desc: elements.settingDesc.value.trim(),
        },
        home: {
          heading: elements.settingHomeHeading.value.trim(),
          intro: elements.settingHomeIntro.value.trim(),
          secondary: elements.settingHomeSecondary.value.trim(),
          socialLabel: elements.settingSocialLabel.value.trim(),
        },
        socials,
      }),
    });

    populateSettings(data.settings);
    setSettingsStatus(`已保存 ${new Date().toLocaleTimeString("zh-CN")}`);
  };

  const populatePage = page => {
    state.page = page;
    elements.pageTitle.value = page.title || "个人简介";
    elements.pageBody.value = page.body || "";
    void renderPagePreview();
    setPagesStatus("简介已加载");
  };

  const loadPage = async () => {
    setPagesStatus("正在加载简介");
    const data = await request("/api/admin/pages/about");
    populatePage(data.page);
  };

  const savePage = async () => {
    setPagesStatus("正在保存简介");
    const data = await request("/api/admin/pages/about", {
      method: "PUT",
      body: JSON.stringify({
        title: elements.pageTitle.value.trim(),
        body: elements.pageBody.value,
      }),
    });
    populatePage(data.page);
    setPagesStatus(`已保存 ${new Date().toLocaleTimeString("zh-CN")}`);
  };

  const createDraft = async () => {
    const now = new Date().toISOString();
    const data = await request("/api/admin/posts", {
      method: "POST",
      body: JSON.stringify({
        title: "未命名文章",
        description: "待补充摘要",
        pubDatetime: now,
        draft: true,
        tags: ["草稿"],
        folder: "drafts",
        body: "# 未命名文章\n\n从这里开始写。\n",
      }),
    });

    state.posts = [data.post, ...state.posts];
    populateEditor(data.post);
    setStatus("草稿已创建");
  };

  const deleteCurrentPost = async () => {
    if (!state.selectedId || !state.selectedPost) return;

    const confirmed = window.confirm(
      `确定删除“${state.selectedPost.title}”吗？这将删除对应的文章文件。`
    );
    if (!confirmed) return;

    setStatus("正在删除");
    const deletedId = state.selectedId;
    const data = await request(`/api/admin/posts/${deletedId}`, {
      method: "DELETE",
    });

    state.posts =
      data.posts || state.posts.filter(post => post.id !== deletedId);
    renderList();

    const nextPost = filteredPosts()[0] || state.posts[0];
    if (nextPost) await loadPost(nextPost.id);
    else clearEditor();

    setStatus(`已删除 ${new Date().toLocaleTimeString("zh-CN")}`);
  };

  const saveCurrentPost = async () => {
    if (!state.selectedId) return;

    setStatus("正在保存");
    const payload = {
      title: elements.title.value.trim(),
      description: elements.description.value.trim(),
      pubDatetime: elements.date.value.trim(),
      tags: elements.tags.value
        .split(",")
        .map(tag => tag.trim())
        .filter(Boolean),
      draft: elements.draft.checked,
      body: elements.body.value,
    };
    const data = await request(`/api/admin/posts/${state.selectedId}`, {
      method: "PUT",
      body: JSON.stringify(payload),
    });

    state.posts = state.posts.map(post =>
      post.id === data.post.id ? data.post : post
    );
    populateEditor(data.post);
    setStatus(`已保存 ${new Date().toLocaleTimeString("zh-CN")}`);
  };

  elements.list.addEventListener("click", event => {
    const item = event.target.closest(".post-item[data-id]");
    if (item)
      loadPost(item.dataset.id).catch(error => setStatus(error.message));
  });

  elements.search.addEventListener("input", renderList);
  elements.status.addEventListener("change", renderList);
  elements.body.addEventListener("input", () => {
    void renderPreview();
  });
  elements.pageBody.addEventListener("input", () => {
    void renderPagePreview();
  });
  elements.newPost.addEventListener("click", () => {
    setAdminView("posts");
    createDraft().catch(error => setStatus(error.message));
  });
  elements.deletePost.addEventListener("click", () => {
    deleteCurrentPost().catch(error => setStatus(error.message));
  });
  elements.form.addEventListener("submit", event => {
    event.preventDefault();
    saveCurrentPost().catch(error => setStatus(error.message));
  });
  elements.settingsForm.addEventListener("submit", event => {
    event.preventDefault();
    saveSettings().catch(error => setSettingsStatus(error.message));
  });
  elements.pageForm.addEventListener("submit", event => {
    event.preventDefault();
    savePage().catch(error => setPagesStatus(error.message));
  });
  elements.postsMode.addEventListener("click", () => setAdminView("posts"));
  elements.pagesMode.addEventListener("click", () => setAdminView("pages"));
  elements.settingsMode.addEventListener("click", () =>
    setAdminView("settings")
  );

  elements.tabs.forEach(button => {
    button.addEventListener("click", () => {
      state.mode = button.dataset.mode;
      elements.surface.dataset.mode = state.mode;
      elements.tabs.forEach(tab =>
        tab.classList.toggle("active", tab === button)
      );
      void renderPreview();
    });
  });

  elements.pageTabs.forEach(button => {
    button.addEventListener("click", () => {
      state.pageMode = button.dataset.pageMode;
      elements.pageSurface.dataset.mode = state.pageMode;
      elements.pageTabs.forEach(tab =>
        tab.classList.toggle("active", tab === button)
      );
      void renderPagePreview();
    });
  });

  setAdminView("posts");
  loadPosts();
</script>
